{
  "info": {
    "name": "BCI - User Registration API",
    "description": "Endpoints de registro de usuarios. Ejecutar en orden con el Collection Runner: el primer request genera un correo único que reutiliza el caso de correo duplicado.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userEmail",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Register - 201 Created",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('userEmail', `juan.${Date.now()}@rodriguez.org`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "",
                  "pm.test('Response contains the user data', () => {",
                  "    pm.expect(body.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/);",
                  "    pm.expect(body.email).to.eql(pm.collectionVariables.get('userEmail'));",
                  "    pm.expect(body.isactive).to.eql(true);",
                  "    pm.expect(body.created).to.be.a('string');",
                  "    pm.expect(body.modified).to.be.a('string');",
                  "    pm.expect(body.last_login).to.be.a('string');",
                  "    pm.expect(body.phones).to.have.lengthOf(1);",
                  "});",
                  "",
                  "pm.test('Password is not returned', () => pm.expect(body).to.not.have.property('password'));",
                  "",
                  "pm.test('Token contains the email claim', () => {",
                  "    const payload = body.token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "    const claims = JSON.parse(atob(payload.padEnd(payload.length + (4 - payload.length % 4) % 4, '=')));",
                  "    pm.expect(claims.email).to.eql(body.email);",
                  "    pm.expect(claims.exp - claims.iat).to.eql(86400);",
                  "});",
                  "",
                  "pm.collectionVariables.set('token', body.token);",
                  "pm.collectionVariables.set('userId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Juan Rodriguez\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"Hunter@2024\",\n  \"phones\": [\n    {\n      \"number\": \"1234567\",\n      \"citycode\": \"1\",\n      \"countrycode\": \"57\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/users/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "register"
              ]
            }
          }
        },
